#!/bin/sh
# sample_venc (自研 RTSP + OSD 时间水印) 开机自启 + 崩溃守护
# 用法: /etc/init.d/S99rtsp {start|stop|restart}
# 要点1: 锁和日志都放 /mnt 的 tmpfs，掉电即清，不写坏 jffs2
# 要点2: 网关/NTP 放后台探测，不拖慢推流

DAEMON=/usr/bin/sample_venc
MNT=/mnt
LOG=$MNT/sample_venc.log
WATCH=$MNT/sample_venc_watch.log
LOCK=$MNT/rtsp.lock
BOOTLOG=/var/log/rtsp.boot.log
MAXLOG=2000000
MAXBOOT=8000
export TZ=CST-8

blog() {
    [ -d /var/log ] || mkdir -p /var/log 2>/dev/null
    sz=$(stat -c %s "$BOOTLOG" 2>/dev/null || echo 0)
    [ "$sz" -gt "$MAXBOOT" ] 2>/dev/null && : > "$BOOTLOG"
    echo "$(date '+%m-%d %H:%M:%S') $*" >> "$BOOTLOG" 2>/dev/null
}

# 必须先把 /mnt 变成 tmpfs，再建锁；否则锁落在 jffs2 上会跨重启残留
setup_mnt() {
    [ -d "$MNT" ] || mkdir -p "$MNT" 2>/dev/null
    if ! grep -q " $MNT tmpfs " /proc/mounts ; then
        mount -t tmpfs -o size=48m none "$MNT" 2>/dev/null
    fi
    if grep -q " $MNT tmpfs " /proc/mounts ; then
        blog "mnt: tmpfs ok"
    else
        blog "mnt: WARN tmpfs failed, logs on rootfs"
    fi
}

# 开机时网口刚 up，ping 网关可能还没通，多试几轮；全失败也硬加一个
setup_route() {
    if route -n | grep -q "^0.0.0.0" ; then
        blog "route: already set"
        return 0
    fi
    gw_ok=0
    try=1
    while [ $try -le 5 ]; do
        for gw in 192.168.3.1 192.168.1.1 ; do
            if ping -c 1 -W 1 $gw >/dev/null 2>&1 ; then
                route add default gw $gw 2>/dev/null && gw_ok=$gw
                break
            fi
        done
        [ "$gw_ok" != "0" ] && break
        try=$((try+1))
        sleep 2
    done
    if [ "$gw_ok" != "0" ] ; then
        blog "route: gw $gw_ok ok"
    else
        route add default gw 192.168.3.1 2>/dev/null
        blog "route: WARN all ping failed, force 3.1 rc=$?"
    fi
}

# 锁不能只看目录在不在，要确认 pid 还活着、而且确实是本脚本
watcher_alive() {
    [ -f "$LOCK/watcher.pid" ] || return 1
    p=$(cat "$LOCK/watcher.pid" 2>/dev/null)
    [ -n "$p" ] || return 1
    kill -0 "$p" 2>/dev/null || return 1
    grep -q "S99rtsp" "/proc/$p/cmdline" 2>/dev/null || return 1
    return 0
}

clean_all() {
    if [ -f "$LOCK/watcher.pid" ] ; then
        kill -9 "$(cat "$LOCK/watcher.pid")" 2>/dev/null
    fi
    for p in $(pgrep -f "init.d/S99rtsp") ; do
        [ "$p" = "$$" ] && continue
        kill -9 "$p" 2>/dev/null
    done
    # 先 TERM 让 HandleSig 走完 VB_Exit；直接 -9 跳过清理，VB 池残留内核
    # 之后 start 必然 SetConf failed，只能重启
    killall -TERM sample_venc 2>/dev/null
    i=0
    while [ $i -lt 10 ] ; do
        pgrep -x sample_venc >/dev/null 2>&1 || break
        sleep 1
        i=$((i+1))
    done
    killall -9 -q sample_venc 2>/dev/null
    sleep 1
    killall -9 -q sample_venc 2>/dev/null
    rm -rf "$LOCK"
}

start_daemon() {
    i=0
    while [ $i -lt 30 ]; do
        ifconfig eth0 2>/dev/null | grep -q "inet addr" && break
        i=$((i+1)); sleep 1
    done
    export SAMPLE_VENC_AUTO=1
    export TZ=CST-8

    # 网关 -> NTP -> 同步 RTC：RTC 必须存 UTC（-u），否则内核按 UTC 读会偏 8 小时
    (
        setup_route
        if ntpd -n -q -p 203.107.6.88 >/dev/null 2>&1 ; then
            hwclock -w -u 2>/dev/null && blog "ntp: ok, rtc synced(utc)"
        else
            blog "ntp: FAILED (no network?)"
        fi
    ) &
    blog "daemon: loop begin"

    fail=0
    while true ; do
        sz=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
        [ "$sz" -gt "$MAXLOG" ] 2>/dev/null && : > "$LOG"
        sz=$(stat -c %s "$WATCH" 2>/dev/null || echo 0)
        [ "$sz" -gt "$MAXLOG" ] 2>/dev/null && : > "$WATCH"

        echo "$(date) start $DAEMON" >> "$WATCH"
        blog "daemon: exec"
        $DAEMON 0 >> "$LOG" 2>&1 &
        wait $!
        rc=$?
        echo "$(date) exited rc=$rc" >> "$WATCH"
        blog "daemon: exit rc=$rc"
        if [ $rc -ne 0 ] ; then fail=$((fail+1)) ; else fail=0 ; fi
        # rc=255 连续 10 次 = VB 公共池残留(SetConf failed)，重启是唯一自愈手段
        if [ $fail -ge 10 ] && [ $rc -eq 255 ] ; then
            blog "daemon: 10x rc=255, VB pool stuck, reboot to recover"
            sleep 2
            reboot -f
            exit 0
        fi
        # 连续失败也不退出，只退避；无人值守时"放弃"比"重试"更糟
        if [ $fail -ge 5 ] ; then
            blog "daemon: $fail failures, backoff 30s"
            fail=0
            sleep 30
        else
            sleep 3
        fi
    done
}

case "$1" in
  stop)
    clean_all
    if pgrep -f sample_venc >/dev/null 2>&1 ; then
        echo "S99rtsp stopped (WARNING: sample_venc still alive)"
    else
        echo "S99rtsp stopped"
    fi
    blog "stop"
    ;;
  restart)
    clean_all
    setup_mnt
    mkdir -p "$LOCK" 2>/dev/null
    start_daemon &
    echo $! > "$LOCK/watcher.pid"
    blog "restart watcher $!"
    echo "S99rtsp restarted (watcher $!)"
    ;;
  *)
    setup_mnt
    if watcher_alive ; then
        echo "already running (watcher $(cat "$LOCK/watcher.pid"))"
        exit 0
    fi
    clean_all
    mkdir -p "$LOCK" 2>/dev/null
    start_daemon &
    echo $! > "$LOCK/watcher.pid"
    blog "boot start watcher $!"
    echo "S99rtsp started (watcher $!)"
    ;;
esac
